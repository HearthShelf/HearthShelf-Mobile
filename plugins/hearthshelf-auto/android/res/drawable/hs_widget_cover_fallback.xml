<?xml version="1.0" encoding="utf-8"?>
<!-- Shown when a book has no downloaded cover on disk. RemoteViews cannot fetch
     a network image, so this is the honest placeholder rather than a blank box. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="6dp" />
    <solid android:color="#2C1F14" />
    <stroke android:width="1dp" android:color="#3D2B1D" />
</shape>
