  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "emulator": "powershell -ExecutionPolicy Bypass -File scripts/boot-emulator.ps1",
    "deploy": "powershell -ExecutionPolicy Bypass -File scripts/deploy.ps1",
    "deploy:native": "powershell -ExecutionPolicy Bypass -File scripts/deploy.ps1 -Prebuild",
    "deploy:away": "powershell -ExecutionPolicy Bypass -File scripts/deploy.ps1 -StandaloneDebug",
    "live": "powershell -ExecutionPolicy Bypass -File scripts/dev-server.ps1",
    "sync-core": "git submodule update --remote packages/core",
    "eas-build-pre-install": "bash scripts/eas-init-submodules.sh",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
